__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.claude

# a chave da API mora aqui; o .env.example é o modelo versionado
.env

# Dados: as pastas ficam no repositório (só o .gitkeep), o conteúdo não.
# Nada aqui é fonte — o app recria as três pastas sozinho no primeiro uso.
input_modpacks/*
!input_modpacks/.gitkeep
!input_modpacks/README.md

output_modpacks/*
!output_modpacks/.gitkeep

.cache/*
!.cache/.gitkeep

# captura do tools/capture_job.py (dados de um pack seu, não é fonte)
tests/ui/job.json

# a área do ferramental de teste (tools/capture_job.py cria quando usada)
test_modpacks/

# zips soltos para comparar exports (o do CurseForge, o do Modrinth, o nosso)
zip/
zips/
