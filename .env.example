# Chave da API do CurseForge (https://console.curseforge.com/#/api-keys)
CURSEFORGE_API_KEY=coloque_sua_chave_aqui

# Tudo daqui para baixo é opcional, e o mesmo que a engrenagem da interface
# edita. Os valores comentados são os padrões.

# Pastas
# M2CF_INPUT_DIR=input_modpacks
# M2CF_OUTPUT_DIR=output_modpacks
# M2CF_CACHE=.cache/curseforge.sqlite3

# Busca no CurseForge
# M2CF_WORKERS=6                # mods procurados em paralelo
# M2CF_MAX_CANDIDATES=8         # projetos com os arquivos inspecionados
# M2CF_SEARCH_PAGES=3           # páginas de resultado por consulta
# M2CF_FILE_PAGES=20            # páginas do histórico de arquivos

# Rede
# M2CF_HTTP_TIMEOUT=60          # segundos por requisição
# M2CF_HTTP_RETRIES=4           # tentativas antes de desistir

# Diagnóstico dos mods não encontrados
# M2CF_RECENT_FILES=10          # arquivos recentes comparados de cada lado
# M2CF_DIAGNOSIS_CANDIDATES=5   # candidatos do CurseForge investigados
# M2CF_VERSION_THRESHOLD=0.85   # similaridade mínima p/ "versão indisponível"

# Área do ferramental de teste (tools/capture_job.py). A interface não aponta
# para cá: é onde se mexe sem sujar as pastas de verdade.
# M2CF_TEST_INPUT_DIR=test_modpacks/input
# M2CF_TEST_OUTPUT_DIR=test_modpacks/output
